<UserControl x:Class="CVGenerator.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:loc="clr-namespace:CVGenerator.Localization"
             xmlns:vm="clr-namespace:CVGenerator.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LandingViewModel}"
             FlowDirection="{Binding WindowFlowDirection, Source={x:Static loc:LocalizationService.Instance}}">
    <UserControl.Resources>
        <Style x:Key="LandingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" Margin="40,30">
                <TextBlock Text="{loc:Loc Landing.Title}" FontSize="34" FontWeight="Bold"
                           Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Landing.Subtitle}" FontSize="15" Foreground="#7F8C8D"
                           HorizontalAlignment="Center" Margin="0,6,0,34"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AI Card -->
                    <Border Grid.Column="0" Style="{StaticResource LandingCardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="🤖" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Landing.AiTitle}" FontSize="24" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,14,0,8"/>
                            <TextBlock Text="{loc:Loc Landing.AiDesc}" FontSize="14" Foreground="#7F8C8D"
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,0,0,22"/>
                            <Button Content="{loc:Loc Landing.LaunchAi}" Height="46" FontSize="15" FontWeight="Bold"
                                    Background="#4CAF50" Foreground="White"
                                    Command="{Binding LaunchAiCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Manual Card -->
                    <Border Grid.Column="1" Style="{StaticResource LandingCardStyle}" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="✏️" FontSize="56" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Landing.ManualTitle}" FontSize="24" FontWeight="Bold"
                                       Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,14,0,8"/>
                            <TextBlock Text="{loc:Loc Landing.ManualDesc}" FontSize="14" Foreground="#7F8C8D"
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,0,0,22"/>
                            <Button Content="{loc:Loc Landing.LaunchManual}" Height="46" FontSize="15" FontWeight="Bold"
                                    Background="#5C6BC0" Foreground="White"
                                    Command="{Binding LaunchManualCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{loc:Loc Landing.Footer}" FontSize="12" Foreground="#B0BEC5"
                           HorizontalAlignment="Center" Margin="0,36,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="CVGenerator.Views.Step3TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:loc="clr-namespace:CVGenerator.Localization"
             xmlns:vm="clr-namespace:CVGenerator.ViewModels"
             xmlns:tl="clr-namespace:CVGenerator.Templates"
             xmlns:conv="clr-namespace:CVGenerator.Converters"
             xmlns:views="clr-namespace:CVGenerator.Views"
             d:DataContext="{d:DesignInstance Type=vm:Step3TemplateViewModel}"
             FlowDirection="{Binding WindowFlowDirection, Source={x:Static loc:LocalizationService.Instance}}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc Wizard.Step3Title}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{loc:Loc Wizard.Step3Subtitle}" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Export toolbar -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                BorderBrush="#D5DBDB" BorderThickness="1" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{loc:Loc Step3.ResumeLanguage}" FontSize="12" Foreground="#2C3E50"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1" Width="140" Height="34" VerticalAlignment="Center"
                          ItemsSource="{Binding DataContext.Step1.ResumeLanguageOptions, RelativeSource={RelativeSource AncestorType={x:Type views:ManualWizardView}}}"
                          SelectedItem="{Binding DataContext.Step1.SelectedResumeLanguage, RelativeSource={RelativeSource AncestorType={x:Type views:ManualWizardView}}, UpdateSourceTrigger=PropertyChanged}"/>

                <ProgressBar Grid.Column="2" Width="80" Height="8" Margin="16,0,0,0" IsIndeterminate="True"
                             VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                <Button Grid.Column="3" Content="{loc:Loc Step3.ExportPdf}" Width="130" Height="38" Margin="16,0,8,0"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="12"
                        Command="{Binding ExportPdfCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}, FallbackValue=True}"/>
                <Button Grid.Column="4" Content="{loc:Loc Step3.ExportDocx}" Width="130" Height="38" Margin="0,0,8,0"
                        Background="#2980B9" Foreground="White" FontWeight="Bold" FontSize="12"
                        Command="{Binding ExportWordCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}, FallbackValue=True}"/>
                <Button Grid.Column="5" Content="{loc:Loc Step3.ExportPpt}" Width="130" Height="38"
                        Background="#F39C12" Foreground="White" FontWeight="Bold" FontSize="12"
                        Command="{Binding ExportPowerPointCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}, FallbackValue=True}"/>
            </Grid>
        </Border>

        <!-- Template cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" CornerRadius="12" Margin="0,0,14,14" Cursor="Hand"
                                BorderThickness="2" Padding="0"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#D5DBDB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2C3E50"/>
                                            <Setter Property="Background" Value="#F4F6F8"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#3498DB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border Height="70" Padding="12" Background="#ECF0F1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Template.Layout}" FontSize="11" Foreground="#7F8C8D"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Margin="2,0"
                                                Background="{Binding Template.PrimaryColor}" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Margin="2,0"
                                                Background="{Binding Template.SecondaryColor}" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Margin="2,0"
                                                Background="{Binding Template.AccentColor}" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="12">
                                    <TextBlock Text="{Binding Template.Name}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Template.Description}" FontSize="11" Foreground="#7F8C8D"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Height="30"/>
                                    <TextBlock FontSize="11" Foreground="#95A5A6" Margin="0,4,0,0"
                                               Text="{Binding Template.FontFamily}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

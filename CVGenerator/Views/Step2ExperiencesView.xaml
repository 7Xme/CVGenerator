<UserControl x:Class="CVGenerator.Views.Step2ExperiencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CVGenerator.Localization"
             xmlns:conv="clr-namespace:CVGenerator.Converters"
             xmlns:vm="clr-namespace:CVGenerator.ViewModels"
             xmlns:sm="clr-namespace:CVGenerator.Models.SectionModels"
             d:DataContext="{d:DesignInstance Type=vm:Step2ExperiencesViewModel}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:SectionTemplateSelector x:Key="SectionSelector">

            <conv:SectionTemplateSelector.ObjectiveTemplate>
                <DataTemplate DataType="{x:Type sm:ObjectiveSection}">
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                             Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
                </DataTemplate>
            </conv:SectionTemplateSelector.ObjectiveTemplate>

            <conv:SectionTemplateSelector.WorkExperienceTemplate>
                <DataTemplate DataType="{x:Type sm:WorkExperienceSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Loc Step2.JobTitle}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc Step2.Employer}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding Employer, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                        VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Loc Step2.City}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc Step2.Period}" FontSize="11" Foreground="#2C3E50"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding StartMonth, UpdateSourceTrigger=PropertyChanged}" Height="30" ToolTip="{loc:Loc Step1.Month}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Year}"/>
                                                        <TextBlock Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="3" Text="{Binding EndMonth, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Month}"/>
                                                        <TextBox Grid.Column="4" Text="{Binding EndYear, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Year}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Content="{loc:Loc Step2.CurrentlyWorking}" Margin="0,8,0,0"
                                                      IsChecked="{Binding IsCurrent, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                                     Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.WorkExperienceTemplate>

            <conv:SectionTemplateSelector.EducationTemplate>
                <DataTemplate DataType="{x:Type sm:EducationSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Loc Step2.Institution}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc Step2.Degree}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding Degree, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                        VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{loc:Loc Step2.FieldOfStudy}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding FieldOfStudy, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc Step2.City}" FontSize="11" Foreground="#2C3E50"/>
                                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding StartMonth, UpdateSourceTrigger=PropertyChanged}" Height="30" ToolTip="{loc:Loc Step1.Month}"/>
                                                <TextBox Grid.Column="1" Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Year}"/>
                                                <TextBlock Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3" Text="{Binding EndMonth, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Month}"/>
                                                <TextBox Grid.Column="4" Text="{Binding EndYear, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="4,0,0,0" ToolTip="{loc:Loc Step1.Year}"/>
                                            </Grid>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                                     Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.EducationTemplate>

            <conv:SectionTemplateSelector.SkillsTemplate>
                <DataTemplate DataType="{x:Type sm:SkillsSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Step2.Skill}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Step2.Level}" FontSize="11" Foreground="#2C3E50"/>
                                            <ComboBox ItemsSource="{Binding DataContext.SkillLevels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.SkillsTemplate>

            <conv:SectionTemplateSelector.LanguagesTemplate>
                <DataTemplate DataType="{x:Type sm:LanguagesSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Step2.Name}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Step2.Level}" FontSize="11" Foreground="#2C3E50"/>
                                            <ComboBox ItemsSource="{Binding DataContext.SkillLevels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.LanguagesTemplate>

            <conv:SectionTemplateSelector.InterestsTemplate>
                <DataTemplate DataType="{x:Type sm:InterestsSection}">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#ECF0F1" CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11" Foreground="#2C3E50"/>
                                            <Button Grid.Column="1" Content="✕" Width="16" Height="16" FontSize="9"
                                                    Background="Transparent" BorderThickness="0" Foreground="#E74C3C" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox Width="180" Height="28"
                                     Text="{Binding DataContext.NewTagText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="{loc:Loc Common.Add}" Height="28" Margin="6,0,0,0" Background="#3498DB"
                                    Foreground="White" FontSize="11"
                                    Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.InterestsTemplate>

            <conv:SectionTemplateSelector.ReferencesTemplate>
                <DataTemplate DataType="{x:Type sm:ReferencesSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Name}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Company}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                    VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Phone}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Email}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.ReferencesTemplate>

            <conv:SectionTemplateSelector.CoursesTemplate>
                <DataTemplate DataType="{x:Type sm:CoursesSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Name}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Institution}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                    VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Date}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Description}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.CoursesTemplate>

            <conv:SectionTemplateSelector.AchievementsTemplate>
                <DataTemplate DataType="{x:Type sm:AchievementsSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Title}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Date}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                    VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                                 Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.AchievementsTemplate>

            <conv:SectionTemplateSelector.PublicationsTemplate>
                <DataTemplate DataType="{x:Type sm:PublicationsSection}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Title}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Publisher}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="✕" Width="26" Height="26" Margin="8,18,0,0"
                                                    VerticalAlignment="Top" Background="#E74C3C" Foreground="White"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Step2.Date}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:Loc Step2.Url}" FontSize="11" Foreground="#2C3E50"/>
                                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:Loc Step2.AddEntry}" Height="30" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White" FontSize="11"
                                Command="{Binding DataContext.AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </conv:SectionTemplateSelector.PublicationsTemplate>

            <conv:SectionTemplateSelector.CustomTemplate>
                <DataTemplate DataType="{x:Type sm:CustomSection}">
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
                </DataTemplate>
            </conv:SectionTemplateSelector.CustomTemplate>

        </conv:SectionTemplateSelector>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Background="White"
                                Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15" FontWeight="Bold" Foreground="#2C3E50"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             Height="30"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="▲" Width="30" Height="26" FontSize="10" Margin="3,0"
                                                Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0"
                                                ToolTip="{loc:Loc Step2.MoveUp}"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="▼" Width="30" Height="26" FontSize="10" Margin="3,0"
                                                Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0"
                                                ToolTip="{loc:Loc Step2.MoveDown}"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="✏️" Width="30" Height="26" FontSize="11" Margin="3,0"
                                                Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0"
                                                ToolTip="{loc:Loc Step2.Rename}"
                                                Command="{Binding DataContext.RenameSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Width="30" Height="26" FontSize="11" Margin="3,0"
                                                Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0"
                                                ToolTip="{loc:Loc Step2.HideInCv}"
                                                Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="👁"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisibleInCv}" Value="False">
                                                                <Setter Property="Text" Value="🚫"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Content="🗑" Width="30" Height="26" FontSize="11" Margin="3,0"
                                                Background="#FDEDEC" Foreground="#E74C3C" BorderThickness="0"
                                                ToolTip="{loc:Loc Step2.Delete}"
                                                Command="{Binding DataContext.DeleteSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#ECF0F1" Margin="0,8,0,0"/>
                                <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource SectionSelector}"
                                                Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1,0,0,0" Background="#F8F9FA" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Step2.AddSection}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <Button Content="{loc:Loc Step2.AddLanguages}" Height="34" Margin="0,0,0,6" Background="#3498DB"
                            Foreground="White" FontSize="11" Command="{Binding AddLanguagesCommand}"/>
                    <Button Content="{loc:Loc Step2.AddCourses}" Height="34" Margin="0,0,0,6" Background="#1ABC9C"
                            Foreground="White" FontSize="11" Command="{Binding AddCoursesCommand}"/>
                    <Button Content="{loc:Loc Step2.AddAchievements}" Height="34" Margin="0,0,0,6" Background="#F39C12"
                            Foreground="White" FontSize="11" Command="{Binding AddAchievementsCommand}"/>
                    <Button Content="{loc:Loc Step2.AddPublications}" Height="34" Margin="0,0,0,6" Background="#8E44AD"
                            Foreground="White" FontSize="11" Command="{Binding AddPublicationsCommand}"/>
                    <Button Content="{loc:Loc Step2.AddCustom}" Height="34" Margin="0,0,0,12" Background="#7F8C8D"
                            Foreground="White" FontSize="11" Command="{Binding AddCustomCommand}"/>

                    <Border Background="#FEF9E7" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Step2.Tips}" FontWeight="Bold" Foreground="#7D6608" FontSize="12"/>
                            <TextBlock Text="{loc:Loc Step2.ObjectivePlaceholder}" FontSize="11" Foreground="#9A7D0A"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

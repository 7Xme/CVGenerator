<UserControl x:Class="CVGenerator.Views.AiModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CVGenerator.Converters"
             xmlns:loc="clr-namespace:CVGenerator.Localization"
             xmlns:vm="clr-namespace:CVGenerator.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2C3E50" Padding="18">
            <StackPanel>
                <TextBlock Text="{loc:Loc Ai.Title}" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc Ai.Subtitle}" FontSize="13" Foreground="#BDC3C7"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="12" Padding="18"
                    Background="White" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ai.ImagePrompt}" FontSize="14" FontWeight="Bold"
                                   Margin="0,0,0,8" Foreground="#2C3E50"/>

                        <Border BorderBrush="#3498DB" BorderThickness="2" CornerRadius="12"
                                Background="#F8F9FA" Height="220" Cursor="Hand"
                                MouseLeftButtonDown="ImageArea_Click">
                            <Grid>
                                <StackPanel x:Name="uploadPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding ImagePreviewPath, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}">
                                    <TextBlock Text="📷" FontSize="46" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Ai.DropHint}" FontSize="12" Foreground="#7F8C8D"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{loc:Loc Ai.Formats}" FontSize="10" Foreground="#BDC3C7"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Image x:Name="imgPreview" Stretch="Uniform"
                                       Source="{Binding ImagePreviewPath}"
                                       Visibility="{Binding ImagePreviewPath, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <Button Content="{loc:Loc Ai.Browse}" Width="150" Height="36" Margin="0,10,0,0"
                                Background="#3498DB" Foreground="White" HorizontalAlignment="Center"
                                Command="{Binding BrowseImageCommand}"/>

                        <TextBlock Text="{loc:Loc Ai.ApiKey}" FontSize="12" FontWeight="Bold"
                                   Margin="0,16,0,4" Foreground="#2C3E50"/>
                        <PasswordBox x:Name="txtApiKey" Height="34"/>

                        <Border Background="#F0F8FF" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding CanGeneratePpt, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Ai.Confidence}" FontSize="11" Foreground="#2C3E50"/>
                                <ProgressBar Value="{Binding ConfidenceScore}" Maximum="1" Height="10"
                                             Margin="0,5,0,0" Foreground="#4CAF50"/>
                                <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0:P1}}" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer MaxHeight="70" Margin="0,8,0,0"
                                      Visibility="{Binding WarningsText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WarningsText}" FontSize="10" Foreground="#E67E22" TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="5" Margin="0,12,0,0"
                                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#7F8C8D"
                                   Margin="0,5,0,0" TextWrapping="Wrap"/>

                        <Button Content="{loc:Loc Ai.Process}" Height="42" Margin="0,12,0,6"
                                Background="#4CAF50" Foreground="White" FontSize="13" FontWeight="Bold"
                                Command="{Binding ProcessImageCommand}"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolToVis}}"/>

                        <Button Content="{loc:Loc Ai.GeneratePpt}" Height="38" Margin="0,0,0,6"
                                Background="#E67E22" Foreground="White" FontSize="12"
                                Command="{Binding GeneratePowerPointCommand}" IsEnabled="{Binding CanGeneratePpt}"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{loc:Loc Ai.PrintPreview}" Height="34"
                                    Background="#8E44AD" Foreground="White" FontSize="11"
                                    Command="{Binding PrintPreviewCommand}" IsEnabled="{Binding CanPrint}" Margin="0,0,3,0"/>
                            <Button Grid.Column="1" Content="{loc:Loc Ai.Print}" Height="34"
                                    Background="#E74C3C" Foreground="White" FontSize="11"
                                    Command="{Binding PrintDirectCommand}" IsEnabled="{Binding CanPrint}" Margin="3,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{loc:Loc Ai.SampleData}" Height="32"
                                    Background="#95A5A6" Foreground="White" FontSize="10"
                                    Command="{Binding LoadSampleDataCommand}" Margin="0,0,3,0"/>
                            <Button Grid.Column="1" Content="{loc:Loc Ai.ExportJson}" Height="32"
                                    Background="#1ABC9C" Foreground="White" FontSize="10"
                                    Command="{Binding ExportDataCommand}" Margin="3,0,0,0"/>
                        </Grid>

                        <Button Content="{loc:Loc Ai.Clear}" Height="32" Margin="0,6,0,0"
                                Background="#E74C3C" Foreground="White" FontSize="10"
                                Command="{Binding ClearAllCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="#ECF0F1" ResizeBehavior="PreviousAndNext"/>

            <!-- Right Panel -->
            <Border Grid.Column="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="12"
                    Padding="14" Background="White" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Loc Ai.Extracted}" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,8" Foreground="#2C3E50"/>

                    <TabControl Grid.Row="1">
                        <TabItem Header="{loc:Loc Ai.TabPersonal}">
                            <ScrollViewer>
                                <StackPanel Margin="8">
                                    <TextBlock Text="{loc:Loc Ai.FullName}" FontSize="11" Foreground="#2C3E50"/>
                                    <TextBox Text="{Binding FullName}" Height="30" Margin="0,3,0,8"/>
                                    <TextBlock Text="{loc:Loc Ai.FullNameLatin}" FontSize="11" Foreground="#2C3E50"/>
                                    <TextBox Text="{Binding FullNameLatin}" Height="30" Margin="0,3,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                            <TextBlock Text="{loc:Loc Ai.Phone1}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding PhonePrimary}" Height="30" Margin="0,3,0,8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                            <TextBlock Text="{loc:Loc Ai.Phone2}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding PhoneSecondary}" Height="30" Margin="0,3,0,8"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Ai.Email}" FontSize="11" Foreground="#2C3E50"/>
                                    <TextBox Text="{Binding Email}" Height="30" Margin="0,3,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                            <TextBlock Text="{loc:Loc Ai.NationalId}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding NationalId}" Height="30" Margin="0,3,0,8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                            <TextBlock Text="{loc:Loc Ai.License}" FontSize="11" Foreground="#2C3E50"/>
                                            <TextBox Text="{Binding DrivingLicense}" Height="30" Margin="0,3,0,8"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Ai.Address}" FontSize="11" Foreground="#2C3E50"/>
                                    <TextBox Text="{Binding Address}" Height="30" Margin="0,3,0,8"/>
                                    <TextBlock Text="{loc:Loc Ai.Summary}" FontSize="11" Foreground="#2C3E50"/>
                                    <TextBox Text="{Binding Summary}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="80" Margin="0,3,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{loc:Loc Ai.TabEducation}">
                            <DataGrid ItemsSource="{Binding EducationList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Degree}" Binding="{Binding Degree}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Institution}" Binding="{Binding Institution}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Year}" Binding="{Binding Year}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Mention}" Binding="{Binding Mention}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="{loc:Loc Ai.TabExperience}">
                            <DataGrid ItemsSource="{Binding ExperienceList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Company}" Binding="{Binding Company}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Position}" Binding="{Binding Position}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.From}" Binding="{Binding StartDate}" Width="90"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.To}" Binding="{Binding EndDate}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="{loc:Loc Ai.TabSkills}">
                            <DataGrid ItemsSource="{Binding SkillList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Ai.SkillName}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Level}" Binding="{Binding Level}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="{loc:Loc Ai.TabLanguages}">
                            <DataGrid ItemsSource="{Binding LanguageList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Ai.SkillName}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ai.Level}" Binding="{Binding Level}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

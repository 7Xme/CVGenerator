<UserControl x:Class="CVGenerator.Views.ManualWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:loc="clr-namespace:CVGenerator.Localization"
             xmlns:conv="clr-namespace:CVGenerator.Converters"
             xmlns:vm="clr-namespace:CVGenerator.ViewModels"
             xmlns:views="clr-namespace:CVGenerator.Views"
             xmlns:sm="clr-namespace:CVGenerator.Models.SectionModels"
             d:DataContext="{d:DesignInstance Type=vm:ManualWizardViewModel}">
    <UserControl.Resources>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
    </UserControl.Resources>

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2C3E50" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Wizard.Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#BDC3C7" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Common.SaveDraft}" Height="30" Margin="0,0,8,0"
                            Background="#3498DB" Foreground="White" FontSize="11" Padding="12,0"
                            Command="{Binding SaveDraftCommand}"/>
                    <Button Content="{loc:Loc Common.LoadDraft}" Height="30" Margin="0,0,8,0"
                            Background="#1ABC9C" Foreground="White" FontSize="11" Padding="12,0"
                            Command="{Binding LoadDraftCommand}"/>
                    <Button Content="{loc:Loc Common.Cancel}" Height="30" Background="#E74C3C"
                            Foreground="White" FontSize="11" Padding="12,0"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step indicator -->
        <Border Grid.Row="1" Padding="18,14,18,6">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BDC3C7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Active">
                                                <Setter Property="Background" Value="#2C3E50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                <Setter Property="Background" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                <TextBlock Text="{Binding Title}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Active">
                                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="18,4,18,0">
            <views:Step1PersonalView DataContext="{Binding Step1}" Visibility="{Binding CurrentStep, Converter={StaticResource IntToVis}, ConverterParameter=1}"/>
            <views:Step2ExperiencesView DataContext="{Binding Step2}" Visibility="{Binding CurrentStep, Converter={StaticResource IntToVis}, ConverterParameter=2}"/>
            <views:Step3TemplateView DataContext="{Binding Step3}" Visibility="{Binding CurrentStep, Converter={StaticResource IntToVis}, ConverterParameter=3}"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{loc:Loc Common.Previous}" Width="120" Height="38"
                        Background="#95A5A6" Foreground="White" FontSize="12"
                        Command="{Binding PreviousCommand}"
                        IsEnabled="{Binding CanGoPrevious}"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="#7F8C8D"
                           VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>

                <Button Grid.Column="2" Width="180" Height="42" FontSize="13" FontWeight="Bold"
                        Background="#4CAF50" Foreground="White"
                        Command="{Binding NextCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="{loc:Loc Common.Next}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Content" Value="{loc:Loc Wizard.Finish}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

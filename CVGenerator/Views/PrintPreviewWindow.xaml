<Window x:Class="CVGenerator.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="معاينة PowerPoint" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="webView" Margin="10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnPrint" Content="🖨️ طباعة" Width="120" Height="40"
                    Background="#8E44AD" Foreground="White" Margin="0,0,10,0"
                    Click="btnPrint_Click"/>
            <Button x:Name="btnOpenInPPT" Content="📊 فتح في PowerPoint" Width="160" Height="40"
                    Background="#3498DB" Foreground="White" Margin="0,0,10,0"
                    Click="btnOpenInPPT_Click"/>
            <Button x:Name="btnClose" Content="إغلاق" Width="100" Height="40"
                    Background="#E74C3C" Foreground="White"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>

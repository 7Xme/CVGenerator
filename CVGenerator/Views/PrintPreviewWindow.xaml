<Window x:Class="CVGenerator.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:loc="clr-namespace:CVGenerator.Localization"
        Title="{loc:Loc PrintPreview.Title}" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding WindowFlowDirection, Source={x:Static loc:LocalizationService.Instance}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="webView" Margin="10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btnPrint" Width="120" Height="40"
                    Background="#8E44AD" Foreground="White" Margin="0,0,10,0"
                    Content="{loc:Loc PrintPreview.Print}"
                    Click="btnPrint_Click"/>
            <Button x:Name="btnOpenInPPT" Width="160" Height="40"
                    Background="#3498DB" Foreground="White" Margin="0,0,10,0"
                    Content="{loc:Loc PrintPreview.OpenInPPT}"
                    Click="btnOpenInPPT_Click"/>
            <Button x:Name="btnClose" Width="100" Height="40"
                    Background="#E74C3C" Foreground="White"
                    Content="{loc:Loc PrintPreview.Close}"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>

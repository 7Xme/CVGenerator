<Window x:Class="CVGenerator.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CVGenerator.Localization"
        Title="{Binding Title}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="{loc:Loc WindowFlowDirection}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox Grid.Row="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 Height="34" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Common.Cancel}" Width="90" Height="32" Margin="0,0,8,0"
                    Background="#95A5A6" Foreground="White" IsCancel="True"/>
            <Button Content="{loc:Loc Common.Save}" Width="90" Height="32" Background="#2C3E50"
                    Foreground="White" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
